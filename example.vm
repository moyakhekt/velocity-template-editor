<!DOCTYPE html>
<html>
<head>
    <title>User Profile - $user.name</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .profile { border: 1px solid #ddd; padding: 20px; border-radius: 5px; }
        .section { margin: 20px 0; }
        ul { list-style-type: none; padding: 0; }
        li { padding: 5px; border-bottom: 1px solid #eee; }
    </style>
</head>
<body>
    ## This is a Velocity template example
    <div class="profile">
        <h1>Welcome, $user.name!</h1>
        
        #if($user.isPremium)
            <span style="color: gold;">⭐ Premium Member</span>
        #else
            <span>Standard Member</span>
        #end

        <div class="section">
            <h2>Profile Information</h2>
            <p><strong>Email:</strong> $user.getEmail()</p>
            <p><strong>Full Name:</strong> $user.getFullName("John", "Doe")</p>
            <p><strong>Greeting:</strong> $user.greet("John")</p>
            <p><strong>Age:</strong> $user.age years old</p>
            <p><strong>Role:</strong> $user.role</p>
            <p><strong>Member Since:</strong> $user.formatDate($user.joinDate)</p>
        </div>

        <div class="section">
            <h2>Utility Functions</h2>
            <p><strong>Max Points:</strong> $util.max(500, $user.points)</p>
            <p><strong>Capitalized Role:</strong> $util.capitalize($user.role)</p>
            <p><strong>Balance:</strong> $util.formatCurrency(1234.5)</p>
        </div>

        <div class="section">
            <h2>Properties File Example</h2>
            <p><strong>App Title:</strong> $util.getProperty("app", "title")</p>
            <p><strong>App Version:</strong> $util.getProperty("app", "version")</p>
            <p><strong>Welcome Message:</strong> $util.getProperty("message", "welcome")</p>
            <p><strong>User First Name:</strong> $util.getProperty("user.name", "first")</p>
        </div>

        #if($user.skills && $user.skills.size() > 0)
        <div class="section">
            <h2>Skills</h2>
            <ul>
            #foreach($skill in $user.skills)
                <li>$skill.name - Level: $skill.level</li>
            #end
            </ul>
        </div>
        #end

        #set($totalPoints = $user.points)
        #if($totalPoints > 1000)
            <div class="section">
                <h2>Achievement Unlocked!</h2>
                <p>You have earned $totalPoints points! 🎉</p>
            </div>
        #end

        <div class="section">
            <h2>Recent Activities</h2>
            <ul>
            #foreach($activity in $activities)
                <li>
                    <strong>$activity.title</strong> - 
                    $activity.date
                    #if($activity.isCompleted)
                        ✓ Completed
                    #end
                </li>
            #end
            </ul>
        </div>
    </div>

    #* 
       This is a multi-line comment
       You can add notes here
    *#
    
    <footer>
        <p>Generated on: $currentDate</p>
    </footer>
</body>
</html>
