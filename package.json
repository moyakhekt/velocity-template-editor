{
  "name": "velocity-template-editor",
  "displayName": "Velocity Template Editor",
  "description": "Apache Velocity template editor with syntax highlighting, live preview, variable management, and method mocks",
  "version": "0.1.0",
  "publisher": "moyakhekt",
  "author": {
    "name": "Khululekile Trevor Moyakhe"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moyakhekt/velocity-template-editor.git"
  },
  "bugs": {
    "url": "https://github.com/moyakhekt/velocity-template-editor/issues"
  },
  "homepage": "https://github.com/moyakhekt/velocity-template-editor#readme",
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:velocity"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "velocity",
        "aliases": [
          "Velocity",
          "velocity"
        ],
        "extensions": [
          ".vm",
          ".vtl",
          ".velocity"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "velocity",
        "scopeName": "text.html.velocity",
        "path": "./syntaxes/velocity.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "velocity.preview",
        "title": "Open Preview",
        "category": "Velocity",
        "icon": "$(open-preview)"
      },
      {
        "command": "velocity.manageContext",
        "title": "Manage Context (Variables & Objects)",
        "category": "Velocity",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "velocity.detectInHtml",
        "title": "Detect Velocity Syntax",
        "category": "Velocity"
      },
      {
        "command": "velocity.runScreenshots",
        "title": "Run Screenshot Tests",
        "category": "Velocity",
        "icon": "$(device-camera)"
      },
      {
        "command": "velocity.openDevTools",
        "title": "Open Developer Tools",
        "category": "Velocity",
        "icon": "$(tools)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "velocity",
          "title": "Velocity",
          "icon": "media/velocity-activitybar.svg"
        }
      ]
    },
    "views": {
      "velocity": [
        {
          "type": "webview",
          "id": "velocity.contextManager",
          "name": "Context Manager"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "velocity.detectInHtml",
          "when": "editorLangId == html"
        }
      ],
      "editor/title": [
        {
          "command": "velocity.preview",
          "when": "resourceLangId == velocity",
          "group": "navigation"
        },
        {
          "command": "velocity.manageContext",
          "when": "resourceLangId == velocity",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "velocity.runScreenshots",
          "when": "view == velocity.contextManager",
          "group": "navigation"
        },
        {
          "command": "velocity.openDevTools",
          "when": "view == velocity.contextManager",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "velocity.manageContext",
          "when": "resourceLangId == velocity",
          "group": "velocity@1"
        }
      ]
    },
    "configuration": {
      "title": "Velocity Template Editor",
      "properties": {
        "velocity.useApacheVelocity": {
          "type": "boolean",
          "default": true,
          "description": "Use Apache Velocity engine for 100% compatibility. Requires Java 17+ and Maven build."
        },
        "velocity.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log debug details: the Velocity server's render steps and each render request (Output › Velocity Server), and the preview page's navigation interception (browser console). Always on when running the extension from source. The server's logging changes after VS Code restarts."
        },
        "velocity.preview.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh preview on document changes"
        },
        "velocity.preview.refreshDelay": {
          "type": "number",
          "default": 500,
          "description": "Delay in milliseconds before refreshing preview"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "compile": "node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "test": "jest",
    "pretest": "npm run compile",
    "lint": "eslint extension --ext ts",
    "build:java": "cd server && mvn clean package -DskipTests",
    "build:all": "npm run compile && npm run build:java",
    "clean": "rimraf out && cd server && mvn clean"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/codicons": "^0.0.44",
    "esbuild": "^0.19.x",
    "eslint": "^8.x",
    "fs-extra": "^11.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.x"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  }
}
