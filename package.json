{
  "name": "velocity-template-editor",
  "displayName": "Velocity Template Editor",
  "description": "Apache Velocity template editor with syntax highlighting, live preview, variable management, and method mocks",
  "version": "0.0.1",
  "publisher": "velocity-editor",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:velocity",
    "onLanguage:html"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "velocity",
        "aliases": [
          "Velocity",
          "velocity"
        ],
        "extensions": [
          ".vm",
          ".vtl",
          ".velocity",
          ".html"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "velocity",
        "scopeName": "text.html.velocity",
        "path": "./syntaxes/velocity.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "velocity.preview",
        "title": "Open Preview",
        "category": "Velocity",
        "icon": "$(open-preview)"
      },
      {
        "command": "velocity.manageContext",
        "title": "Manage Context (Variables & Objects)",
        "category": "Velocity",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "velocity.detectInHtml",
        "title": "Detect Velocity Syntax",
        "category": "Velocity"
      },
      {
        "command": "velocity.runScreenshots",
        "title": "Run Screenshot Tests",
        "category": "Velocity",
        "icon": "$(device-camera)"
      },
      {
        "command": "velocity.openDevTools",
        "title": "Open Developer Tools",
        "category": "Velocity",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "velocity.preview",
          "when": "resourceLangId == velocity",
          "group": "navigation"
        },
        {
          "command": "velocity.manageContext",
          "when": "resourceLangId == velocity",
          "group": "navigation"
        },
        {
          "command": "velocity.runScreenshots",
          "when": "activeWebviewPanelId == 'velocityContext'",
          "group": "navigation"
        },
        {
          "command": "velocity.openDevTools",
          "when": "activeWebviewPanelId == 'velocityContext'",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "velocity.manageContext",
          "when": "resourceLangId == velocity",
          "group": "velocity@1"
        }
      ]
    },
    "configuration": {
      "title": "Velocity Template Editor",
      "properties": {
        "velocity.useApacheVelocity": {
          "type": "boolean",
          "default": true,
          "description": "Use Apache Velocity engine for 100% compatibility. Requires Java 11+ and Maven build."
        },
        "velocity.preview.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh preview on document changes"
        },
        "velocity.preview.refreshDelay": {
          "type": "number",
          "default": 500,
          "description": "Delay in milliseconds before refreshing preview"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "compile": "node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "test": "jest",
    "pretest": "npm run compile",
    "lint": "eslint extension --ext ts",
    "build:java": "cd server && mvn clean package -DskipTests",
    "build:all": "npm run compile && npm run build:java",
    "clean": "rimraf out && cd server && mvn clean"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/codicons": "^0.0.44",
    "esbuild": "^0.19.x",
    "eslint": "^8.x",
    "fs-extra": "^11.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.x"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  }
}
